{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/cleaner", "destination": "/cleaner.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron?job=warmup",        "schedule": "0 14 * * *" },
    { "path": "/api/cron?job=ical-sync",     "schedule": "0 11 * * *" },
    { "path": "/api/cron",                   "schedule": "0 17 * * *" },
    { "path": "/api/cron?job=campaign-send", "schedule": "0 13 * * *" }
  ]
}
